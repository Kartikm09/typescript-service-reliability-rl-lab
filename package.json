{
  "name": "typescript-service-reliability-rl-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "tsc -b --clean && rm -rf dist-tests coverage",
    "format": "prettier --write \"packages/**/*.ts\" \"tests/**/*.ts\" \"benchmarks/**/*.mjs\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"tests/**/*.ts\" \"benchmarks/**/*.mjs\" \"*.{json,mjs}\"",
    "lint": "eslint packages tests",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b --pretty false",
    "test": "node --test dist-tests/unit/*.test.js",
    "test:integration": "node --test dist-tests/integration/*.test.js",
    "coverage": "c8 --check-coverage --lines 80 --functions 75 --branches 70 npm test",
    "benchmark": "node benchmarks/service-benchmark.mjs",
    "start:api": "node packages/api/dist/main.js",
    "test:smoke": "node scripts/smoke_http.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "c8": "12.0.0",
    "eslint": "10.10.0",
    "fast-check": "4.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
