@@ -1,3 +1,3 @@
 export interface Content { readonly id:string;readonly title:string;readonly body:string; }
 export interface ValidationResult { readonly values:readonly Content[];readonly errors:readonly string[];readonly parsePasses:number; }
-export function validate(payloads:readonly string[]):ValidationResult{const values:Content[]=[];const errors:string[]=[];let parsePasses=0;for(const payload of payloads){try{parsePasses+=1;const id=(JSON.parse(payload) as Record<string,unknown>).id;parsePasses+=1;const title=(JSON.parse(payload) as Record<string,unknown>).title;parsePasses+=1;const body=(JSON.parse(payload) as Record<string,unknown>).body;if(typeof id!=="string")errors.push("id");else if(typeof title!=="string")errors.push("title");else if(typeof body!=="string")errors.push("body");else values.push({id,title,body});}catch{errors.push("json");}}return{values,errors,parsePasses};}
+export function validate(payloads:readonly string[]):ValidationResult{const values:Content[]=[];const errors:string[]=[];let parsePasses=0;for(const payload of payloads){try{parsePasses+=1;const record=JSON.parse(payload) as Record<string,unknown>;const{id,title,body}=record;if(typeof id!=="string")errors.push("id");else if(typeof title!=="string")errors.push("title");else if(typeof body!=="string")errors.push("body");else values.push({id,title,body});}catch{errors.push("json");}}return{values,errors,parsePasses};}
